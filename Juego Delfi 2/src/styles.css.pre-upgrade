:root {
  color: #eef7ff;
  background: #07101c;
  font-family: Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
  font-synthesis: none;
}

* { box-sizing: border-box; }

body {
  margin: 0;
  min-width: 320px;
  min-height: 100vh;
  background:
    radial-gradient(circle at 15% 0%, #143557 0, transparent 32rem),
    linear-gradient(180deg, #07101c, #03070d);
}

.shell { width: min(1480px, 100%); margin: 0 auto; padding: 18px; }
.topbar, footer { display: flex; align-items: end; justify-content: space-between; gap: 24px; }
.topbar { margin-bottom: 12px; }
.eyebrow { color: #6de6ee; font-size: .72rem; font-weight: 800; letter-spacing: .18em; text-transform: uppercase; }
h1 { margin: 2px 0 0; font-size: clamp(1.5rem, 4vw, 2.4rem); line-height: 1; }
.topbar p, footer { color: #9fb5c8; }
.topbar p { margin: 0; text-align: right; }
.game-frame { position: relative; overflow: hidden; border: 1px solid #2b536d; border-radius: 18px; background: #02050a; box-shadow: 0 24px 70px #0009; }
#game { width: 100%; aspect-ratio: 16 / 9; }
#game canvas { display: block; width: 100% !important; height: 100% !important; }
footer { align-items: center; flex-wrap: wrap; padding: 12px 4px 0; font-size: .82rem; }
.touch-controls { position: absolute; inset: auto 18px 18px; display: none; justify-content: space-between; pointer-events: none; }
.touch-controls button { width: 62px; height: 62px; margin-right: 8px; border: 1px solid #fff5; border-radius: 50%; color: white; background: #07101caa; font-size: 1.35rem; pointer-events: auto; touch-action: none; backdrop-filter: blur(8px); }
.touch-controls .jump { margin-left: auto; background: #19aebaad; }

@media (hover: none), (pointer: coarse) {
  .touch-controls { display: flex; }
  footer { padding-bottom: 76px; }
}

@media (max-width: 700px) {
  .shell { padding: 8px; }
  .topbar p { display: none; }
  .game-frame { border-radius: 10px; }
  footer { font-size: .72rem; }
}
